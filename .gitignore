# --- Data (large / regenerated) ---
data/raw/*
data/interim/*
data/processed/*
# keep manifests, external reference data, and folder structure
!data/raw/_manifests/
!data/external/
!data/**/.gitkeep
# ADP cache is regenerable (re-fetched from FantasyFootballCalculator) — not committed
data/external/adp_*.parquet

# --- Reports (regenerated artifacts) ---
reports/figures/*
reports/results/*
# Regenerable serving outputs (projections / keeper board / redraft board) — rebuild via
# `make project` / keeper.py / `make redraft`
reports/projections_*.csv
reports/keeper_board.csv
reports/redraft_*.csv
reports/postseason_*.csv
reports/postseason_*.md
!reports/**/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.python-version-local
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- uv ---
# uv.lock IS committed (reproducibility); the env dir is not.

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
