# Each sport is its own project under sports/<sport>/; its data cache + generated reports are
# regenerable and git-ignored (committed: manifests, external reference data, REPORT_*.md, versions/).

# --- Data (large / regenerated) ---
sports/*/data/raw/*
sports/*/data/interim/*
sports/*/data/processed/*
# keep manifests, external reference data, and folder structure
!sports/*/data/raw/_manifests/
!sports/*/data/external/
!sports/*/data/**/.gitkeep
# ADP cache is regenerable (re-fetched from FantasyFootballCalculator) — not committed
sports/*/data/external/adp_*.parquet

# --- Reports (regenerated artifacts) ---
sports/*/reports/figures/*
sports/*/reports/results/*
# Regenerable serving outputs (projections / keeper board / redraft board / postseason)
sports/*/reports/projections_*.csv
sports/*/reports/keeper_board.csv
sports/*/reports/redraft_*.csv
sports/*/reports/postseason_*.csv
sports/*/reports/postseason_*.md
!sports/*/reports/**/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.python-version-local
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- uv ---
# uv.lock IS committed (reproducibility); the env dir is not.

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
